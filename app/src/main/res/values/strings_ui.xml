    <!-- Reliability -->
    <string name="ui_reliability_intro">Everything an alarm needs from this phone. The list updates while this screen is open.</string>
    <string name="ui_check_status_ok">Working</string>
    <string name="ui_check_status_problem">Needs fixing</string>
