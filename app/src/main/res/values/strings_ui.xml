    <!-- For screen readers. %1$s is the button label, %2$s the check title. -->
    <string name="ui_check_fix_description">%1$s, %2$s</string>
    <string name="ui_check_notifications">Notifications</string>
    <string name="ui_check_notifications_ok">Allowed. The ringing screen is opened by a notification.</string>
    <string name="ui_check_notifications_problem">Blocked. Without notifications the alarm sounds but the ringing screen never opens.</string>
    <string name="ui_check_ringing_channel">Ringing alarm category</string>
    <string name="ui_check_ringing_channel_ok">At full importance. The ringing notification can open the ringing screen.</string>
    <string name="ui_check_ringing_channel_problem">Silenced or switched off. The alarm still sounds, but on a locked phone the ringing screen does not open. Set the Ringing alarm category back to its loudest level.</string>
    <string name="ui_check_full_screen">Full-screen alarm</string>
    <string name="ui_check_full_screen_ok">Allowed. The ringing screen shows over the lock screen.</string>
    <string name="ui_check_full_screen_problem">Not allowed. On a locked phone you would only get a small notification.</string>
    <string name="ui_check_exact_alarms">Exact alarms</string>
    <string name="ui_check_exact_alarms_ok">Allowed. Alarms ring at the exact minute.</string>
    <string name="ui_check_exact_alarms_problem">Not allowed. Alarms cannot be scheduled at all.</string>
    <string name="ui_check_dnd">Do Not Disturb</string>
    <string name="ui_check_dnd_ok">Alarms can sound.</string>
    <string name="ui_check_dnd_problem">Do Not Disturb is muting alarms right now. Allow alarms in its settings.</string>
    <string name="ui_check_dnd_unknown">Do Not Disturb is on and rem cannot see whether it lets alarms through. Check that alarms are allowed.</string>
    <string name="ui_check_background">Background use</string>
    <string name="ui_check_background_ok">Not restricted.</string>
    <string name="ui_check_background_problem">Restricted. The phone may stop rem before an alarm rings. Set battery use to unrestricted.</string>
    <string name="ui_check_camera">Camera</string>
    <string name="ui_check_camera_ok">Allowed. Barcodes can be scanned.</string>
    <string name="ui_check_camera_problem">Not allowed. You would have to type the 40 character code to stop an alarm.</string>
    <string name="ui_check_barcode">Barcodes</string>
    <string name="ui_check_barcode_ok">Every alarm that is on has a barcode.</string>
    <string name="ui_check_barcode_problem">An alarm that is on has no barcode. A plain button stops it.</string>
    <string name="ui_check_barcode_fix">Add a barcode</string>
    <string name="ui_test_alarm_title">Test it</string>
    <string name="ui_test_alarm_body">Sets a real alarm one minute from now. Press the button, then lock the phone and wait.</string>
    <!-- %s is a clock time. -->
    <string name="ui_test_alarm_scheduled">Test alarm set for %s. Lock the phone now and wait. It needs no barcode: stop it with the button on the ringing screen.</string>
    <string name="ui_test_alarm_refused">The test alarm was not set. This phone does not let rem set exact alarms. Fix the Exact alarms check above and try again.</string>
    <string name="ui_test_alarm_button">Test alarm in 1 minute</string>
    <string name="ui_oem_title">Battery managers</string>
    <string name="ui_oem_generic">Some phones stop apps in the background to save battery, and alarms with them. dontkillmyapp.com lists the settings to change for each brand.</string>
    <string name="ui_oem_huawei">Huawei and Honor phones stop background apps. In Settings, Battery, App launch, set rem to manage manually and allow all three options.</string>
    <string name="ui_oem_xiaomi">Xiaomi phones block apps from starting after a reboot. In the app info for rem, turn on Autostart and set Battery saver to No restrictions.</string>
    <string name="ui_oem_oneplus">OnePlus phones stop background apps. In the app info for rem, set Battery to Don\'t optimize and allow auto-launch.</string>
    <string name="ui_oem_samsung">Samsung phones put unused apps to sleep. In Settings, Battery, Background usage limits, add rem to Never sleeping apps.</string>
    <string name="ui_oem_oppo">Oppo and realme phones stop background apps. In the app info for rem, allow auto-launch and background activity.</string>
    <string name="ui_oem_vivo">Vivo phones stop background apps. In Settings, Battery, Background power consumption management, allow rem. Also allow autostart.</string>
    <string name="ui_oem_asus">Asus phones block apps from starting on their own. In Mobile Manager, Auto-start manager, allow rem.</string>
    <string name="ui_oem_link">Open dontkillmyapp.com</string>

    <!-- Onboarding -->
    <string name="ui_onboarding_notifications_title">Alarms need notifications</string>
    <string name="ui_onboarding_notifications_body">Android opens the ringing screen through a notification. If notifications are off, an alarm sounds but nothing shows on the lock screen. rem sends no other notifications, except to tell you an alarm was missed.</string>
    <string name="ui_onboarding_notifications_allow">Allow notifications</string>
    <string name="ui_onboarding_barcode_title">Pick a barcode to get up for</string>
    <string name="ui_onboarding_barcode_body">Each alarm stops only when you scan one of its barcodes. Choose something away from your bed, like the toothpaste in the bathroom, and add it to the alarm. There is no snooze.</string>
    <string name="ui_onboarding_add_alarm">Add an alarm</string>
    <string name="ui_onboarding_skip">Not now</string>
